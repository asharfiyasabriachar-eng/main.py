name: Video Dubbing Pipeline

on:
  workflow_dispatch: # इससे आप GitHub पर जाकर खुद एक क्लिक से इसे चला सकेंगी

jobs:
  run-dubbing:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install yt-dlp pydub

      - name: Run Dubbing Script
        run: |
          python main.py
